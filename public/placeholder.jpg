<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="100%" height="100%">
  <defs>
    <radialGradient id="luxGrad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#161614" />
      <stop offset="100%" stop-color="#0B0B0A" />
    </radialGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E5C77F" />
      <stop offset="50%" stop-color="#C9A052" />
      <stop offset="100%" stop-color="#9C7730" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="800" fill="url(#luxGrad)" />

  <!-- Elegant Inner Border -->
  <rect x="40" y="40" width="720" height="720" rx="24" fill="none" stroke="url(#gold)" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.4" />

  <!-- Center Decorative Diamond & Sparkle -->
  <g transform="translate(400, 360)">
    <!-- Fine luxury circle -->
    <circle r="90" fill="none" stroke="url(#gold)" stroke-width="1.5" opacity="0.6" />
    <circle r="75" fill="none" stroke="url(#gold)" stroke-width="0.75" stroke-dasharray="2 3" opacity="0.4" />

    <!-- Diamond / Star icon -->
    <path d="M0 -45 L12 -12 L45 0 L12 12 L0 45 L-12 12 L-45 0 L-12 -12 Z" fill="url(#gold)" />
    <circle cx="0" cy="0" r="4" fill="#0B0B0A" />
  </g>

  <!-- Brand Typography -->
  <text x="400" y="495" font-family="'Playfair Display', Georgia, serif" font-size="28" font-style="italic" font-weight="600" fill="#E5C77F" text-anchor="middle" letter-spacing="2">
    DRL Resin &amp; Décor
  </text>
  <text x="400" y="525" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="600" text-transform="uppercase" fill="#94A3B8" text-anchor="middle" letter-spacing="4">
    Artisan Creation Photo Coming Soon
  </text>
</svg>